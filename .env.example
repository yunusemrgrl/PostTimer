APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

INSTAGRAM_API_VERSION=v25.0
INSTAGRAM_RUPLOAD_HOST=rupload.facebook.com

# Business Login for Instagram (App Dashboard > Instagram > Business login settings)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# Telegram bot default token (takım bazlı ayar girilmediğinde TelegramBotService varsayılan olarak kullanır)
TELEGRAM_BOT_TOKEN=
DB_QUEUE_RETRY_AFTER=900
MCP_TOKEN=
FFMPEG_BINARY=ffmpeg

# ElevenLabs — SADECE Text-to-Speech (dubbing endpoint'i kaldırıldı)
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_22050_64
ELEVENLABS_TIMEOUT=120

# Google Gemini — video analizi + timestamp'li çeviri
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=300
# Cloudflare R2 Ayarları
# PRODUCTION İÇİN R2_URL MUTLAKA bucket'a bağlı bir CUSTOM DOMAIN olmalı
# (örn. https://media.postimer.com), asla r2.dev test alan adı değil.
# r2.dev yönetilen public adresi test içindir ve variabil rate-limit +
# bant genişliği throttle uygular — büyük videoları hem tarayıcı hem
# Instagram Graph API indirmede kilitleyebilir.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_DEFAULT_REGION=auto
R2_USE_PATH_STYLE_ENDPOINT=false
R2_URL=

CURATOR_DEFAULT_DISK=r2
